{
  "name": "@nialto-services/astro-form-submissions",
  "version": "0.3.1",
  "type": "module",
  "description": "Form submissions toolkit for Astro sites.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NialtoServices/astro-form-submissions.git"
  },
  "packageManager": "pnpm@10.30.2",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./form": {
      "types": "./dist/client/form.d.ts",
      "import": "./dist/client/form.js"
    }
  },
  "imports": {
    "#*": {
      "astro-form-submissions:source": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "build": "node scripts/generate-email-template-sources.mjs && rm -rf dist && tsc -p tsconfig.build.json",
    "check": "node scripts/generate-email-template-sources.mjs && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node scripts/generate-email-template-sources.mjs && vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:browser": "playwright test",
    "prepublishOnly": "prettier --check . && pnpm check && pnpm lint && pnpm test && pnpm test:workers && pnpm build && pnpm test:browser && pnpm test:dist",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "mustache": "^4.2.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.64.1",
    "@types/mustache": "^4.2.6",
    "astro": "^7.3.5",
    "aws4fetch": "^1.0.20",
    "content-disposition": "^3.0.0",
    "email-addresses": "^5.0.0",
    "eslint": "^10.6.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.10.6",
    "msw": "^2.15.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
